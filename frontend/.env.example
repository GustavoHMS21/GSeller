# Variáveis do FRONTEND. Copie para .env.local e ajuste.
#
# Tudo que começa com NEXT_PUBLIC_ é embutido no JavaScript enviado ao navegador.
# Portanto: apenas valores públicos aqui. Segredos ficam exclusivamente no backend.
# O build falha se uma variável NEXT_PUBLIC_ tiver nome de segredo (ver next.config.ts).

# Supabase: URL do projeto e publishable key (sb_publishable_...). Nunca a secret key.
NEXT_PUBLIC_SUPABASE_URL=https://<projeto>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Endereço da API, usado só pelo servidor do Next.js (não vai para o navegador).
API_URL=http://localhost:8000
