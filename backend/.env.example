# =================================================================
# Variáveis do BACKEND. Copie para backend/.env (cp .env.example .env) e ajuste.
# Nunca coloque valores reais neste arquivo — ele é versionado.
# =================================================================

# development | staging | production
APP_ENV=development

# Conexão usada pela API em runtime (role sem privilégio de DDL e sem BYPASSRLS).
DATABASE_URL=postgresql+asyncpg://app_runtime:runtime_dev@127.0.0.1:5440/seller_dev

# Conexão usada somente pelas migrations (role dona do schema).
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://app_migrator:migrator_dev@127.0.0.1:5440/seller_dev

# Origens autorizadas a chamar a API (separadas por vírgula). Nunca "*".
CORS_ORIGINS=http://localhost:3000

# Chave de criptografia dos tokens de marketplace (Fernet, base64 de 32 bytes).
# Gerar: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Autenticação (preenchido no bloco de Auth).
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=authenticated

# Mercado Livre (preenchido no bloco de OAuth).
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=

# Shopee (P1).
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=

LOG_LEVEL=INFO

# Stripe (somente chaves de TESTE no desenvolvimento: sk_test_...). Nunca no frontend.
STRIPE_SECRET_KEY=
# Gerado pelo `stripe listen` (desenvolvimento) ou pelo endpoint do painel (produção).
STRIPE_WEBHOOK_SECRET=
# Para onde o Stripe devolve o usuário depois do pagamento (e base dos links nos e-mails).
FRONTEND_URL=http://localhost:3000

# E-mails pelo Resend (Bloco 59). Chave só de envio (re_...), nunca no frontend.
# Sem RESEND_API_KEY e EMAIL_FROM, nenhum e-mail é enviado.
RESEND_API_KEY=
# Remetente em um domínio verificado no Resend, ex.: GSeller <nao-responda@avisos.seudominio.com.br>
EMAIL_FROM=
# Opcional: para onde vão as respostas dos usuários.
EMAIL_REPLY_TO=
