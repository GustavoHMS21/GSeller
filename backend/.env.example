# =================================================================
# Variáveis do BACKEND. Copie para backend/.env (cp .env.example .env) e ajuste.
# Nunca coloque valores reais neste arquivo — ele é versionado.
# =================================================================

# development | staging | production
APP_ENV=development

# Conexão usada pela API em runtime (role sem privilégio de DDL e sem BYPASSRLS).
DATABASE_URL=postgresql+asyncpg://app_runtime:runtime_dev@127.0.0.1:5440/seller_dev

# Conexão usada somente pelas migrations (role dona do schema).
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://app_migrator:migrator_dev@127.0.0.1:5440/seller_dev

# Origens autorizadas a chamar a API (separadas por vírgula). Nunca "*".
CORS_ORIGINS=http://localhost:3000

# Chave de criptografia dos tokens de marketplace (Fernet, base64 de 32 bytes).
# Gerar: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Autenticação (preenchido no bloco de Auth).
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=authenticated

# Mercado Livre (preenchido no bloco de OAuth).
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=

# Shopee (P1).
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=

LOG_LEVEL=INFO
